# shellcheck shell=bash
#
# Aliases. Sourced by .zshrc; keep POSIX-compatible so bash can use it too.

# ---------------------------------------------------------------------------
# Shell
# ---------------------------------------------------------------------------
alias :q='exit'
alias :wq='exit'
alias c='clear'
alias reload='exec ${SHELL} -l'
alias path='echo -e ${PATH//:/\\n}'
alias now='date +"%Y-%m-%d %H:%M:%S"'
alias week='date +%V'
alias ports='ss -tulpn 2>/dev/null || netstat -tulpn'
alias myip='curl -fsSL https://ifconfig.me && echo'
alias serve='python3 -m http.server'

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'
alias proj='cd ~/Projects'

# Safety: prompt before clobbering, and show what was done.
alias cp='cp -iv'
alias mv='mv -iv'
# -I prompts once for bulk deletes (GNU only); BSD/macOS rm falls back to -i.
if rm --help 2>&1 | grep -q '\-I'; then alias rm='rm -Iv'; else alias rm='rm -iv'; fi
alias mkdir='mkdir -pv'
alias df='df -h'
alias du='du -h'
alias free='free -h'

# ---------------------------------------------------------------------------
# Modern replacements, with graceful fallbacks
# ---------------------------------------------------------------------------
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -l --group-directories-first --git'
  alias la='eza -la --group-directories-first --git'
  alias lt='eza --tree --level=2'
else
  alias ls='ls --color=auto 2>/dev/null || ls -G'
  alias ll='ls -lh'
  alias la='ls -lah'
fi

command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'
command -v batcat >/dev/null 2>&1 && alias cat='batcat --paging=never'
command -v fdfind >/dev/null 2>&1 && alias fd='fdfind'
alias grep='grep --color=auto'   # rg is great, but it is not a grep drop-in
command -v btop >/dev/null 2>&1 && alias top='btop'
command -v nvim >/dev/null 2>&1 && alias vim='nvim'
command -v tldr >/dev/null 2>&1 && alias help='tldr'

# ---------------------------------------------------------------------------
# Git
# ---------------------------------------------------------------------------
alias g='git'
alias gs='git status --short --branch'
alias ga='git add'
alias gaa='git add --all'
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gpl='git pull --rebase --autostash'
alias gf='git fetch --all --prune'
alias gc='git checkout'
alias gcb='git checkout -b'
alias gcm='git checkout "$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed s@^refs/remotes/origin/@@ || echo main)" && git pull --rebase'
alias gd='git diff'
alias gds='git diff --staged'
alias gl='git lg'
alias gcam='git commit --amend --no-edit'
alias gst='git stash'
alias gstp='git stash pop'
alias grh='git reset --hard'
alias wip='git add --all && git commit -m "WIP" --no-verify'
alias unwip='git reset HEAD~'
alias gclean='git clean -fd'
command -v lazygit >/dev/null 2>&1 && alias lg='lazygit'

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
alias d='docker'
alias dc='docker compose'
alias dcu='docker compose up -d'
alias dcd='docker compose down'
alias dcl='docker compose logs -f --tail=100'
alias dcb='docker compose build'
alias dcr='docker compose restart'
alias dps='docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"'
alias dpsa='docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}"'
alias di='docker images'
alias dstop='docker stop $(docker ps -q)'
# Reclaim disk: stopped containers, dangling images, unused networks and cache.
alias dprune='docker system prune -af --volumes'
command -v lazydocker >/dev/null 2>&1 && alias ld='lazydocker'

# ---------------------------------------------------------------------------
# Kubernetes
# ---------------------------------------------------------------------------
alias k='kubectl'
alias kg='kubectl get'
alias kd='kubectl describe'
alias kl='kubectl logs -f --tail=100'
alias kx='kubectx'
alias kns='kubens'
alias kgp='kubectl get pods -o wide'
alias kgs='kubectl get svc'
alias kaf='kubectl apply -f'

# ---------------------------------------------------------------------------
# Languages & frameworks
# ---------------------------------------------------------------------------

# PHP / Laravel
alias art='php artisan'
alias tinker='php artisan tinker'
alias phpunit='vendor/bin/phpunit'
alias pest='vendor/bin/pest'
alias pint='vendor/bin/pint'
alias cda='composer dump-autoload -o'
alias ci='composer install'
alias cu='composer update'
alias mmo='php artisan make:model'
alias ms='php artisan make:seeder'
alias mpr='php artisan make:provider'
alias rl='php artisan route:list'
alias mig='php artisan migrate'
alias migf='php artisan migrate:fresh --seed'

# Node
alias js='node'
alias ni='npm install'
alias nr='npm run'
alias nrd='npm run dev'
alias nrb='npm run build'
alias nrt='npm run test'
alias nlg='npm list -g --depth=0'
alias pn='pnpm'

# Python
alias py='python3'
alias pip='python3 -m pip'
alias venv='python3 -m venv .venv && source .venv/bin/activate'
alias activate='source .venv/bin/activate'

# Terraform
alias tf='terraform'
alias tfp='terraform plan'
alias tfa='terraform apply'
alias tfi='terraform init'
