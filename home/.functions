# shellcheck shell=bash
#
# Shell functions — things that need arguments or logic, where an alias
# would not do.

# Create a directory and cd into it.
mkcd() {
  mkdir -p "$1" && cd "$1" || return 1
}

# Extract any common archive format.
extract() {
  if [ -z "$1" ]; then
    echo "usage: extract <archive>" >&2
    return 1
  fi
  [ -f "$1" ] || {
    echo "extract: '$1' is not a file" >&2
    return 1
  }
  case "$1" in
    *.tar.bz2 | *.tbz2) tar xjf "$1" ;;
    *.tar.gz | *.tgz) tar xzf "$1" ;;
    *.tar.xz) tar xJf "$1" ;;
    *.tar) tar xf "$1" ;;
    *.bz2) bunzip2 "$1" ;;
    *.gz) gunzip "$1" ;;
    *.zip) unzip "$1" ;;
    *.7z) 7z x "$1" ;;
    *.rar) unrar x "$1" ;;
    *.Z) uncompress "$1" ;;
    *) echo "extract: unsupported format: $1" >&2 && return 1 ;;
  esac
}

# Timestamped copy of a file, for the "just before I break it" moment.
bak() {
  cp -a "$1" "$1.$(date +%Y%m%d-%H%M%S).bak"
}

# What is listening on a port, and who owns it.
port() {
  if [ -z "$1" ]; then
    echo "usage: port <number>" >&2
    return 1
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$1" -sTCP:LISTEN
  else
    ss -tulpn "sport = :$1"
  fi
}

# Kill whatever holds a port. Handy when a dev server refuses to die.
killport() {
  if [ -z "$1" ]; then
    echo "usage: killport <number>" >&2
    return 1
  fi
  local pids
  pids="$(lsof -ti tcp:"$1" 2>/dev/null)"
  if [ -z "$pids" ]; then
    echo "nothing listening on port $1"
    return 0
  fi
  echo "$pids" | xargs kill -9 && echo "killed: $pids"
}

# Clone a repo and cd into it.
gclone() {
  git clone "$1" "${2:-}" && cd "$(basename "${2:-$1}" .git)" || return 1
}

# Open a shell inside a running container, falling back to sh.
dsh() {
  if [ -z "$1" ]; then
    echo "usage: dsh <container> [shell]" >&2
    return 1
  fi
  docker exec -it "$1" "${2:-bash}" 2>/dev/null || docker exec -it "$1" sh
}

# Fuzzy-pick a container and follow its logs.
dlogs() {
  local container
  container="$(docker ps --format '{{.Names}}' | fzf --select-1 --query "${1:-}")" || return 1
  docker logs -f --tail=100 "$container"
}

# Fuzzy-pick a git branch and check it out.
gco() {
  local branch
  branch="$(git branch --all --sort=-committerdate |
    grep -v HEAD | sed 's/^[* ] //;s#remotes/[^/]*/##' | awk '!seen[$0]++' |
    fzf --select-1 --query "${1:-}")" || return 1
  git checkout "$(echo "$branch" | tr -d '[:space:]')"
}

# A .gitignore for a stack, straight from gitignore.io.
gi() {
  if [ -z "$1" ]; then
    echo "usage: gi <list,of,stacks>   e.g. gi node,laravel,macos" >&2
    return 1
  fi
  curl -fsSL "https://www.toptal.com/developers/gitignore/api/$*"
}

# Human-readable size of a path (defaults to the current directory).
dush() {
  du -sh "${1:-.}"/* 2>/dev/null | sort -rh | head -n "${2:-20}"
}

# Serve the current directory over HTTP.
webserver() {
  local port="${1:-8000}"
  echo "serving $(pwd) on http://localhost:${port}"
  python3 -m http.server "$port"
}

# Pretty-print JSON from a file, a pipe or an argument.
json() {
  if [ -t 0 ] && [ -n "${1:-}" ]; then
    jq . "$1"
  else
    jq .
  fi
}

# Full history of a single file, patches included.
gfhist() {
  git log --follow -p -- "$1"
}

# Update everything that can be updated on this machine.
update-all() {
  if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update && sudo apt-get upgrade -y && sudo apt-get autoremove -y
  fi
  if command -v brew >/dev/null 2>&1; then
    brew update && brew upgrade && brew cleanup
  fi
  command -v snap >/dev/null 2>&1 && sudo snap refresh
  command -v npm >/dev/null 2>&1 && npm update -g
  command -v pipx >/dev/null 2>&1 && pipx upgrade-all
  command -v rustup >/dev/null 2>&1 && rustup update
  [ -d "${ZSH:-$HOME/.oh-my-zsh}" ] && command -v omz >/dev/null 2>&1 && omz update
  return 0
}
