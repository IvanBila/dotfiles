# Nothing machine-specific or secret belongs in this repository.

# Local overrides, created on the machine and never committed.
home/.gitconfig.local
home/.zshrc.local
home/.zshenv.local
*.local

# Backups made by install.sh
.dotfiles-backup/

# Editor and OS noise
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Vim runtime state (only plugins.vim is tracked)
home/.vim/plugged/
home/.vim/autoload/
home/.vim/undo/
home/.vim/swap/
home/.vim/backup/
home/.vim/.netrwhist

# Secrets
*.pem
*.key
*.gpg
.env
